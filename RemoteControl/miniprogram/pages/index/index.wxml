<view class="page">
  <view class="header">
    <view class="brand"><text class="accent">〃</text> 遥控驾驶舱 <text class="connection {{connected ? 'online' : ''}}">{{connected ? '● 已连接' : '○ 未连接'}}</text></view>
    <view class="header-actions"><button class="primary" bindtap="connect" disabled="{{connecting || connected}}">{{connecting ? '搜索中' : '连接小车'}}</button><button bindtap="connectWifi">连接画面</button><button bindtap="toggleDetails">{{details ? '收起状态' : '连接状态'}}</button></view>
  </view>
  <view class="dashboard">
    <view class="panel movement">
      <view class="section-title">{{mode === 'tilt' ? '体感控制' : '移动'}}</view>
      <view wx:if="{{mode === 'joystick'}}" class="joy-area">
        <view id="joystick" class="joystick" catchtouchstart="joyStart" catchtouchmove="joyMove" catchtouchend="joyEnd" catchtouchcancel="release"><text class="arrow up">▲</text><text class="arrow down">▼</text><text class="arrow left">◀</text><text class="arrow right">▶</text><view class="knob" style="transform:translate({{joyX}}px, {{joyY}}px)"></view></view>
        <text class="hint">前后移动 · 左右横移</text>
      </view>
      <view wx:else class="tilt-area">
        <view class="grip-label">手机顶端（听筒）朝向</view>
        <view class="segments"><button class="{{grip === 'left' ? 'selected' : ''}}" data-grip="left" bindtap="changeGrip">朝左</button><button class="{{grip === 'right' ? 'selected' : ''}}" data-grip="right" bindtap="changeGrip">朝右</button></view>
        <view class="sensor">{{sensor}}</view>
        <button class="calibrate {{tiltLatched ? 'active' : ''}}" bindtap="toggleTilt">{{tiltLatched ? '停止体感' : '校准并开始'}}</button>
        <text class="hint">{{tiltLatched ? '回到校准握姿即停止移动' : '保持舒适握姿，点击一次即可'}}</text>
      </view>
      <view class="speed"><text class="hint">速度选择</text><view class="segments"><button class="{{percent === 50 ? 'selected' : ''}}" data-scale="0.5" bindtap="speed">低</button><button class="{{percent === 75 ? 'selected' : ''}}" data-scale="0.75" bindtap="speed">中</button><button class="{{percent === 100 ? 'selected' : ''}}" data-scale="1" bindtap="speed">高</button></view></view>
    </view>
    <view class="center">
      <view class="tabs"><view class="tab {{mode === 'joystick' ? 'selected' : ''}}" data-mode="joystick" bindtap="mode">摇杆操控</view><view class="tab {{mode === 'tilt' ? 'selected' : ''}}" data-mode="tilt" bindtap="mode">手机体感</view></view>
      <view class="video-stage">
        <image wx:for="{{frames}}" wx:key="*this" class="camera {{flipped ? 'flipped' : ''}} {{videoFresh ? '' : 'waiting-image'}}" src="{{item}}" mode="aspectFit" data-path="{{item}}" bindload="frameLoaded" binderror="frameError" />
        <text class="video-label">第一视角 {{videoFresh ? '· 实时' : ''}}</text>
        <view wx:if="{{!videoFresh}}" class="video-placeholder"><view class="viewfinder">⌗</view><view>{{videoOn ? '正在等待小车画面' : '画面未开启'}}</view><text class="hint">{{videoOn ? videoText : '连接小车 Wi-Fi 后开启画面'}}</text></view>
        <view class="video-actions"><button bindtap="flipVideo">翻转 180°</button><button bindtap="toggleVideo">{{videoOn ? '暂停画面' : '开启画面'}}</button></view>
      </view>
      <view class="status-line">{{status}}</view>
    </view>
    <view class="panel actions">
      <view class="section-title">转向</view>
      <view class="turn-row"><view class="turn" data-sign="1" catchtouchmove="preventScroll" catchtouchstart="turnStart" catchtouchend="turnEnd" catchtouchcancel="release"><text>↶</text>左转</view><view class="turn" data-sign="-1" catchtouchmove="preventScroll" catchtouchstart="turnStart" catchtouchend="turnEnd" catchtouchcancel="release"><text>↷</text>右转</view></view>
      <view class="hint turn-hint">按住旋转，松手停止</view>
      <view class="face-section"><view class="section-title">屏幕表情</view><picker range="{{faceOptions}}" value="{{faceIndex}}" bindchange="chooseFace" disabled="{{!connected}}"><view class="face-picker">{{statusFresh ? faceOptions[faceIndex] : '等待同步'}}<text>⌄</text></view></picker></view>
      <button class="stop" bindtap="release">立即停止</button>
    </view>
  </view>
  <view wx:if="{{details}}" class="details">
    <view class="details-heading"><text>连接与传感器状态</text><button bindtap="toggleDetails">关闭</button></view>
    <scroll-view scroll-y class="details-body"><view>{{status}}</view><view class="hint">{{wifiText}}</view><view>{{videoText}}</view><view class="hint">{{sensorDetail}}</view><view class="setting"><text>转手机旋转（罗盘）</text><switch checked="{{useCompass}}" bindchange="toggleCompass" color="#ed922f"/></view><button bindtap="retrySensors">重新启用传感器</button><view class="hint">左右 {{x}} · 前后 {{y}} m/s · 旋转 {{w}} rad/s</view><view class="hint">眩晕 {{statusFresh ? dizzy : '—'}} · 疲劳 {{statusFresh ? fatigue : '—'}} · {{fault ? '停车保护' : '小车状态'}}（疲劳不是电量）</view><button bindtap="disconnect" disabled="{{!connecting && !connected}}">断开蓝牙</button></scroll-view>
  </view>
</view>
