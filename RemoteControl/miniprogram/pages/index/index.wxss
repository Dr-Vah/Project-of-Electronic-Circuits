page { background:#edf3ee; color:#203d31; font-family:system-ui,sans-serif; font-size:26rpx; }
.page { padding:28rpx 26rpx 170rpx; }
.heading,.connection-row,.video-toolbar,.video-buttons,.speed-row,.tabs,.turn-row,.mood-title,.face-picker { display:flex; align-items:center; justify-content:space-between; gap:12rpx; }
.eyebrow { font-size:18rpx; letter-spacing:4rpx; color:#74877b; }
.title { font-size:42rpx; font-weight:700; margin-top:4rpx; }
.badge { padding:8rpx 14rpx; background:#dfe5e0; border-radius:30rpx; font-size:20rpx; white-space:nowrap; }
.online { color:#26794b; background:#d8efdf; }.fault { color:#9e3535; background:#f7dede; }
.status { margin:14rpx 0; font-size:24rpx; }
button { margin:0; padding:0 18rpx; font-size:24rpx; border-radius:14rpx; background:#f9fcf9; color:#294f3b; }
button::after { border:0; }button[disabled] { opacity:.5; }
button.primary,.selected { background:#285c43 !important; color:#fff !important; }
.connection-row button { flex:1; padding:0 8rpx; white-space:nowrap; }
.hint { color:#748177; font-size:21rpx; line-height:1.6; }.wifi { margin:12rpx 0 18rpx; }
.video-card,.controls,.mood-card { background:#fff; border-radius:24rpx; overflow:hidden; margin-bottom:18rpx; }
.video-stage { height:330rpx; position:relative; background:#13281e; }
.camera { position:absolute; width:100%; height:100%; }.flipped { transform:rotate(180deg); }.waiting-image { opacity:0; }
.video-placeholder { position:absolute; inset:0; display:flex; align-items:center; justify-content:center; flex-direction:column; color:#d8e8dc; gap:8rpx; }.video-icon { font-size:50rpx; color:#72ac87; }
.live-dot { position:absolute; left:18rpx; top:14rpx; color:#a2e2b2; font-size:20rpx; background:#13281e99; padding:4rpx 12rpx; border-radius:20rpx; }
.video-toolbar { padding:14rpx; align-items:flex-start; flex-wrap:wrap; font-size:20rpx; color:#667c6c; }
.video-buttons { margin-left:auto; } .video-buttons button { font-size:21rpx; line-height:2.2; }
.controls { padding:18rpx; }.tabs { background:#eef4ef; border-radius:16rpx; padding:5rpx; }.tab { flex:1; text-align:center; padding:13rpx 0; border-radius:12rpx; font-weight:600; }
.speed-row { margin:14rpx 0; justify-content:center; font-size:22rpx; }.speed-row button { line-height:2; padding:0 26rpx; }
.sensor { font-size:21rpx; text-align:center; color:#728478; margin:8rpx 0; }
.drive { line-height:1.5; width:100%; background:#cbe8d4; text-align:center; padding:30rpx 6rpx; border-radius:20rpx; font-size:34rpx; font-weight:600; }.active { background:#8acf9e; }.drive-note { font-size:20rpx; font-weight:400; }
.turn-row { margin-top:14rpx; }.turn { flex:1; text-align:center; background:#e6efe8; padding:20rpx 0; border-radius:14rpx; font-size:26rpx; }
.readout { font-size:20rpx; color:#728478; text-align:center; margin-top:12rpx; }
.joystick-row { display:flex; align-items:center; justify-content:space-around; padding:8rpx 0; }.joystick { width:160px; height:160px; border-radius:50%; background:#e7f1e9; position:relative; flex-shrink:0; overflow:hidden; }
.cross { position:absolute; background:#d0e1d4; }.horizontal { height:1px; width:100%; top:50%; }.vertical { width:1px; height:100%; left:50%; }
.knob { width:54px; height:54px; position:absolute; left:53px; top:53px; background:#427e57; border-radius:50%; box-shadow:0 3px 10px #285c4333; }
.joy-label { color:#6e8273; text-align:center; font-size:20rpx; line-height:1.9; }
.mood-card { padding:20rpx; }.mood-title { font-weight:600; margin-bottom:18rpx; }.meter-row { display:flex; align-items:center; gap:16rpx; margin:12rpx 0; font-size:22rpx; }.meter-row text { width:120rpx; }.meter-row progress { flex:1; }
.face-picker { margin:18rpx 0 10rpx; padding:18rpx; background:#f0f5f1; border-radius:14rpx; }.face-picker text { color:#6b8473; }
.footer-note { margin:16rpx 6rpx; }.stop-dock { position:fixed; bottom:0; left:0; right:0; padding:14rpx 26rpx calc(14rpx + env(safe-area-inset-bottom)); background:#edf3eef2; border-top:1px solid #dce7de; }.stop { background:#b84947; color:white; font-size:30rpx; font-weight:600; line-height:2.6; }
