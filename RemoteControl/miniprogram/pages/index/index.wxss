/* Override WeChat v2's button:not([size='mini']) fixed width. */
.page button:not([size='mini']) {
  width: auto;
  min-width: 0;
  max-width: 100%;
  box-sizing: border-box;
  margin-left: 0;
  margin-right: 0;
}
.page button.calibrate,
.page button.stop {
  width: 100%;
  min-width: 0;
  max-width: 100%;
  align-self: stretch;
  flex-shrink: 0;
  text-align: center;
}
.panel,.tilt-area,.header-actions { min-width: 0; }
.header-actions { flex-shrink: 1; }
.header-actions button { white-space: nowrap; }
.video-actions { max-width: calc(100% - 16px); }
