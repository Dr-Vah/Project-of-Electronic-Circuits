page {
  background: #ffffff;
  color: #1a1a1a;
  font-family: system-ui, sans-serif;
  font-size: 28rpx;
  height: 100%;
  overflow: hidden;
}

view, button { box-sizing: border-box; }

button {
  margin: 0;
  padding: 0 28rpx;
  background: #f2f3f5;
  color: #333;
  border-radius: 12rpx;
  font-size: 28rpx;
  line-height: 72rpx;
  border: 1px solid #e5e6e8;
}
button::after { border: 0; }
button[disabled] { opacity: .5; color: #bbb; }

.page {
  height: 100vh;
  padding: 20rpx 24rpx calc(20rpx + env(safe-area-inset-bottom));
  display: flex;
  flex-direction: column;
  gap: 16rpx;
  background: #ffffff;
}

.header { display: flex; align-items: center; justify-content: center; flex-wrap: wrap; gap: 12rpx; }
.brand { font-weight: 700; font-size: 36rpx; }
.conn { font-size: 24rpx; color: #999; }
.conn.on { color: #07c160; }
.header-actions { display: flex; gap: 12rpx; }

.primary, .selected {
  background: #07c160 !important;
  color: #fff !important;
  border-color: #07c160 !important;
}

.video-stage {
  position: relative;
  width: 100%;
  height: 320rpx;
  border: 1px solid #e5e6e8;
  background: #f7f8f9;
  border-radius: 16rpx;
  overflow: hidden;
  flex-shrink: 0;
}
.camera { position: absolute; width: 100%; height: 100%; }
.flipped { transform: rotate(180deg); }
.waiting-image { opacity: 0; }
.video-placeholder {
  position: absolute;
  inset: 0;
  display: flex;
  flex-direction: column;
  justify-content: center;
  align-items: center;
  gap: 12rpx;
  color: #bbb;
  text-align: center;
}
.viewfinder { font-size: 72rpx; color: #ddd; }
.video-actions { position: absolute; bottom: 16rpx; right: 16rpx; display: flex; gap: 12rpx; }
.video-actions button { font-size: 24rpx; line-height: 56rpx; background: #ffffff; border: 1px solid #e5e6e8; }

.tabs {
  display: flex;
  border: 1px solid #e5e6e8;
  border-radius: 40rpx;
  background: #f2f3f5;
  padding: 6rpx;
  flex-shrink: 0;
}
.tab { flex: 1; border-radius: 34rpx; text-align: center; padding: 14rpx 0; font-size: 28rpx; color: #666; }
.tab.selected { background: #07c160; color: #fff; }

.control { flex: 1; min-height: 0; display: flex; align-items: center; justify-content: center; }
.joy-area { width: 100%; height: 100%; display: flex; align-items: center; justify-content: center; }
.joystick {
  position: relative;
  width: min(62vw, 42vh);
  height: min(62vw, 42vh);
  max-width: 320px;
  max-height: 320px;
  border-radius: 50%;
  background: #ffffff;
  border: 1px solid #e5e6e8;
  box-shadow: 0 2px 12px rgba(0, 0, 0, .06);
  flex-shrink: 0;
}
.cross { position: absolute; background: #e5e6e8; }
.cross-h { left: 14%; right: 14%; top: 50%; height: 1px; }
.cross-v { top: 14%; bottom: 14%; left: 50%; width: 1px; }
.knob {
  position: absolute;
  width: 32%;
  height: 32%;
  left: 34%;
  top: 34%;
  border-radius: 50%;
  background: #07c160;
  box-shadow: 0 2px 6px rgba(7, 193, 96, .35);
}

.tilt-area { width: 100%; display: flex; flex-direction: column; gap: 20rpx; align-items: center; }
.sensor { font-size: 24rpx; color: #999; text-align: center; line-height: 1.5; }
.calibrate { background: #07c160; color: #fff; border: none; font-weight: 700; line-height: 84rpx; width: 100%; }
.calibrate.active { background: #fa5151; }

.bottom-row { display: flex; gap: 12rpx; align-items: flex-end; flex-shrink: 0; }
.bottom-row picker { flex: 1; min-width: 0; }
.speed { flex: 0 0 300rpx; display: flex; flex-direction: column; gap: 6rpx; }
.speed-label { font-size: 22rpx; color: #999; line-height: 1; text-align: center; }
.segments { display: flex; gap: 12rpx; width: 100%; }
.segments button { flex: 1; padding: 0; line-height: 68rpx; }

.turn-row { display: flex; gap: 12rpx; flex-shrink: 0; }
.turn {
  flex: 1;
  border: 1px solid #e5e6e8;
  border-radius: 16rpx;
  background: #ffffff;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  height: 132rpx;
  font-size: 28rpx;
  color: #333;
}
.turn text { font-size: 56rpx; color: #07c160; line-height: 1.15; }

.face-picker {
  display: flex;
  justify-content: space-between;
  align-items: center;
  border: 1px solid #e5e6e8;
  border-radius: 12rpx;
  background: #ffffff;
  padding: 0 24rpx;
  line-height: 68rpx;
  font-size: 26rpx;
  color: #333;
  flex-shrink: 0;
}

.status-line { font-size: 22rpx; line-height: 32rpx; min-height: 32rpx; max-height: 64rpx; overflow: hidden; color: #999; text-align: center; flex-shrink: 0; }

.details {
  position: absolute;
  z-index: 10;
  left: 32rpx;
  right: 32rpx;
  top: 120rpx;
  bottom: 64rpx;
  padding: 24rpx;
  background: #ffffff;
  border: 1px solid #e5e6e8;
  border-radius: 16rpx;
  box-shadow: 0 8px 30px rgba(0, 0, 0, .1);
}
.details-heading { display: flex; align-items: center; justify-content: space-between; gap: 12rpx; height: 56rpx; font-weight: 700; }
.details-body { height: calc(100% - 64rpx); margin-top: 12rpx; }
.details-body view { margin-bottom: 16rpx; }
.details-body button { margin-bottom: 16rpx; }
.details-body .muted { color: #999; font-size: 24rpx; }
.setting { display: flex; align-items: center; justify-content: space-between; }
.setting switch { transform: scale(.75); transform-origin: right center; }

/* Override WeChat v2's button:not([size='mini']) fixed width. */
.page button:not([size='mini']) {
  width: auto;
  min-width: 0;
  max-width: 100%;
  box-sizing: border-box;
  margin-left: 0;
  margin-right: 0;
}
.page button.calibrate {
  width: 100%;
  min-width: 0;
  max-width: 100%;
  align-self: stretch;
  flex-shrink: 0;
  text-align: center;
}
.page picker, .header-actions, .tilt-area { min-width: 0; }
.header-actions { flex-shrink: 1; }
.header-actions button { white-space: nowrap; }
.video-actions { max-width: calc(100% - 16px); }
